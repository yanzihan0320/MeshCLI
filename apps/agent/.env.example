# MeshCLI local configuration template.
# Copy this file to apps/agent/.env. Never commit the copied file or real secrets.
# Values marked optional may be omitted; the documented value is the runtime default.

# -----------------------------------------------------------------------------
# Model providers
# -----------------------------------------------------------------------------

# OpenAI or any provider compatible with /v1/chat/completions.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional native Anthropic provider. Leave the key empty when unused.
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/messages
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Optional Google model for the Python LangGraph service only. OpenAI takes
# precedence when both keys are configured.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# -----------------------------------------------------------------------------
# Local services
# -----------------------------------------------------------------------------

# Browser origin allowed to call the local BFF and the BFF listening port.
FRONTEND_ORIGIN=http://localhost:5173
PORT=4000

# Local LangGraph Agent Server. LANGGRAPH_PORT controls `npm run dev:agent`;
# LANGGRAPH_URL is the address used by the BFF.
LANGGRAPH_PORT=8133
LANGGRAPH_URL=http://127.0.0.1:8133
# Client-side pacing between LangGraph model calls. Keep 0 for provider plans
# with sufficient RPM/TPM/concurrency; set a positive value only when required.
LANGGRAPH_MODEL_MIN_INTERVAL_SECONDS=0
# Maximum characters returned by one read-only MCP tool call (4,000-40,000).
LANGGRAPH_MCP_RESULT_MAX_CHARS=16000
LANGGRAPH_GRAPH_ID=default
LANGGRAPH_NODE_GRAPH_ID=node-supervisor

# Keep LangGraph as the supervisor for node Agent Mode. Set false only when
# deliberately diagnosing the direct OpenHands execution path.
AGENT_LANGGRAPH_SUPERVISOR=true

# -----------------------------------------------------------------------------
# Node Agent execution and OpenHands isolation
# -----------------------------------------------------------------------------

AGENT_ADAPTER=openhands
AGENT_WORKSPACE_MODE=docker
AGENT_REQUIRE_CLEAN_WORKTREE=false
AGENT_MAX_ITERATIONS=60
AGENT_LLM_MAX_RETRIES=5
AGENT_DOCKER_HEALTH_TIMEOUT=180
OPENHANDS_AGENT_SERVER_IMAGE=ghcr.io/openhands/agent-server:1.36.1-python

# Optional fallback Git project used only when a Workspace Binding has not been
# created in the MeshCLI UI. Prefer the UI Workspace Binding for normal use.
AGENT_WORKSPACE_ROOT=

# Optional comma-separated model allowlist for node Agent Mode. When omitted,
# MeshCLI permits the configured OPENAI_MODEL.
AGENT_ALLOWED_MODELS=

# Advanced interpreter overrides. Normally the install scripts and local
# virtual environments discover these automatically.
# MESHCLI_PYTHON=C:/path/to/python.exe
# OPENHANDS_PYTHON=C:/path/to/MeshCLI/apps/openhands/.venv/Scripts/python.exe

# -----------------------------------------------------------------------------
# Managed run storage and cleanup
# -----------------------------------------------------------------------------

# Optional storage directory. When omitted, MeshCLI uses the operating system's
# local application-data directory (for example %LOCALAPPDATA%/MeshCLI/runs).
AGENT_RUNS_DIR=

# Automatic cleanup defaults: keep runs for 7 days, retain at most 200 runs,
# and cap total managed run data at 1 GiB.
AGENT_RUN_RETENTION_DAYS=7
AGENT_MAX_RETAINED_RUNS=200
AGENT_RUN_STORAGE_MAX_BYTES=1073741824

# -----------------------------------------------------------------------------
# Skills and MCP capability registry
# -----------------------------------------------------------------------------

# Optional shared registry path used by the BFF, Python Agent service, and CLI.
# Leave unset to use the standard per-user MeshCLI application-data location.
# MESHCLI_CAPABILITIES_PATH=C:/path/to/capabilities.json

# Built-in read-only filesystem MCP. Its root is never accepted from the
# browser; it is resolved from the BFF-validated Workspace Binding.
MESHCLI_FILESYSTEM_MCP_ENABLED=true
MESHCLI_FILESYSTEM_MCP_COMMAND=npx
MESHCLI_FILESYSTEM_MCP_PACKAGE=@modelcontextprotocol/server-filesystem

# -----------------------------------------------------------------------------
# Optional LangSmith tracing
# -----------------------------------------------------------------------------

# Tracing may upload prompts, tool inputs, canvas context, and repository-derived
# content to LangSmith. Enable it only when this is acceptable for the project.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=meshcli-local

# The US LangSmith cloud endpoint is the SDK default. Set one of these only for
# another region, a self-hosted deployment, or a multi-workspace API key.
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_WORKSPACE_ID=
