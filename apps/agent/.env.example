# OpenAI or any provider compatible with /v1/chat/completions.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=replace-with-your-key
OPENAI_MODEL=gpt-4o-mini

# Optional native Anthropic provider.
ANTHROPIC_API_KEY=replace-with-your-key
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Browser origin allowed to call the local BFF.
FRONTEND_ORIGIN=http://localhost:5173

# Phase 3 OpenHands execution. Point this at the real Git project the Agent may analyze.
AGENT_ADAPTER=openhands
AGENT_WORKSPACE_ROOT=/absolute/path/to/project
AGENT_RUNS_DIR=/optional/path/for/ephemeral-run-data
AGENT_ALLOWED_MODELS=gpt-4o-mini
AGENT_RUN_RETENTION_DAYS=7
AGENT_RUN_STORAGE_MAX_BYTES=1073741824
AGENT_MAX_RETAINED_RUNS=200
AGENT_WORKSPACE_MODE=docker
AGENT_REQUIRE_CLEAN_WORKTREE=false
OPENHANDS_AGENT_SERVER_IMAGE=ghcr.io/openhands/agent-server:1.36.1-python
AGENT_MAX_ITERATIONS=60

# Phase 5B read-only MCP. The repository root is always resolved from Workspace Binding.
LANGGRAPH_URL=http://127.0.0.1:8133
LANGGRAPH_GRAPH_ID=default
MESHCLI_FILESYSTEM_MCP_ENABLED=true
MESHCLI_FILESYSTEM_MCP_COMMAND=npx
MESHCLI_FILESYSTEM_MCP_PACKAGE=@modelcontextprotocol/server-filesystem
