# OpenAI or any provider compatible with /v1/chat/completions.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=replace-with-your-key
OPENAI_MODEL=gpt-4o-mini

# Optional native Anthropic provider.
ANTHROPIC_API_KEY=replace-with-your-key
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Browser origin allowed to call the local BFF.
FRONTEND_ORIGIN=http://localhost:5173

# Phase 3 OpenHands execution. Point this at the real Git project the Agent may analyze.
AGENT_ADAPTER=openhands
AGENT_WORKSPACE_ROOT=/absolute/path/to/project
AGENT_WORKSPACE_MODE=docker
AGENT_REQUIRE_CLEAN_WORKTREE=true
OPENHANDS_AGENT_SERVER_IMAGE=ghcr.io/openhands/agent-server:1.36.1-python
AGENT_MAX_ITERATIONS=60
